+// corten-matrix: log the raw field shape of relayed SMS/RCS payloads. serde
+// drops fields the structs above do not declare, so this walks the plist
+// itself, to find any field that tells identical-member group threads apart.
+// Temporary diagnostic: remove this patch once captures are collected.
+//
+// Message IDs and protocol fields print as-is, but only at their exact known
+// paths; the same name anywhere else is treated as unknown. Body fields print
+// by length only. Every other string or data value, including each array
+// element, prints by length plus a short hash: enough to compare two payloads
+// without recording the value.
+const SMS_RELAY_SHAPE_TARGET: &str = "sms_relay_shape";
+const SMS_RELAY_PLAIN_PATHS: &[&str] = &["cs", "g", "m", "sV", "fh", "b", "chat-style", "mD.guid", "mD.replyToGuid", "mD.service", "mD.sV"];
+const SMS_RELAY_BODY_KEYS: &[&str] = &["k", "plain-body", "xhtml"];
+
+fn sms_relay_fingerprint(bytes: &[u8]) -> String {
+    encode_hex(&sha256(bytes)[..4])
+}
+
+fn sms_relay_shape(path: &str, key: &str, value: &Value, out: &mut Vec<String>) {
+    let body = SMS_RELAY_BODY_KEYS.contains(&key);
+    match value {
+        Value::Dictionary(dict) if body => out.push(format!("{path}=dict(len={})", dict.len())),
+        Value::Array(items) if body => out.push(format!("{path}=array(len={})", items.len())),
+        Value::Dictionary(dict) => {
+            let mut entries: Vec<(&String, &Value)> = dict.iter().collect();
+            entries.sort_by(|a, b| a.0.cmp(b.0));
+            for (k, v) in entries {
+                let child = if path.is_empty() { k.clone() } else { format!("{path}.{k}") };
+                sms_relay_shape(&child, k, v, out);
+            }
+        }
+        Value::Array(items) => {
+            out.push(format!("{path}=array(len={})", items.len()));
+            for (i, item) in items.iter().enumerate() {
+                sms_relay_shape(&format!("{path}[{i}]"), key, item, out);
+            }
+        }
+        Value::String(s) if body => out.push(format!("{path}=str(len={})", s.len())),
+        Value::String(s) if SMS_RELAY_PLAIN_PATHS.contains(&path) => out.push(format!("{path}={s}")),
+        Value::String(s) => out.push(format!("{path}=str(len={},fp={})", s.len(), sms_relay_fingerprint(s.as_bytes()))),
+        Value::Data(d) if body => out.push(format!("{path}=data(len={})", d.len())),
+        Value::Data(d) => out.push(format!("{path}=data(len={},fp={})", d.len(), sms_relay_fingerprint(d))),
+        Value::Integer(n) => out.push(format!("{path}={n}")),
+        Value::Boolean(b) => out.push(format!("{path}={b}")),
+        Value::Real(r) => out.push(format!("{path}={r}")),
+        Value::Date(_) => out.push(format!("{path}=date")),
+        Value::Uid(u) => out.push(format!("{path}=uid({})", u.get())),
+        _ => out.push(format!("{path}=other")),
+    }
+}
+
+fn log_sms_relay_shape(kind: &str, value: &Value) {
+    if !log::log_enabled!(target: SMS_RELAY_SHAPE_TARGET, log::Level::Info) {
+        return;
+    }
+    let mut fields = vec![];
+    sms_relay_shape("", "", value, &mut fields);
+    info!(target: SMS_RELAY_SHAPE_TARGET, "SMS relay payload shape: kind={kind} fields=[{}]", fields.join(", "));
+}
