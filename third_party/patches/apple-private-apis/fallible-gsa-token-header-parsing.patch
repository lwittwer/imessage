+
+/// Parse one base64 `ID:TOKEN[:DURATION][:EXPIRATION]` GSA token header into
+/// its ID and token. Apple mixes seconds-from-now and milliseconds-since-epoch
+/// in the trailing field (the SMS 2FA endpoint appends both), so the last
+/// numeric field wins. Values above 40 years expressed in seconds are treated
+/// as epoch milliseconds; smaller values are relative seconds. A missing field
+/// falls back to `default_secs` from now.
+/// A malformed header is an error, never a panic: a surprising response must
+/// fail the login step, not unwind through the host application.
+fn parse_token_header(data: &str, default_secs: u64) -> Result<(String, FetchedToken), Error> {
+    let decoded = base64::decode(data).map_err(|_| Error::BadTokenHeader("not base64".to_string()))?;
+    let decoded = String::from_utf8(decoded).map_err(|_| Error::BadTokenHeader("not UTF-8".to_string()))?;
+    let parts = decoded.split(':').collect::<Vec<&str>>();
+    let (Some(id), Some(token)) = (parts.first(), parts.get(1)) else {
+        return Err(Error::BadTokenHeader("missing token field".to_string()));
+    };
+    if id.is_empty() || token.is_empty() {
+        return Err(Error::BadTokenHeader("empty id or token field".to_string()));
+    }
+    let expiration = match parts.get(3).or(parts.get(2)) {
+        Some(raw) => {
+            let value = raw.trim().parse::<u64>()
+                .map_err(|_| Error::BadTokenHeader("expiration is not a number".to_string()))?;
+            if value > 40 * 365 * 24 * 60 * 60 {
+                // ms since epoch
+                SystemTime::UNIX_EPOCH.checked_add(Duration::from_millis(value))
+            } else {
+                SystemTime::now().checked_add(Duration::from_secs(value))
+            }
+        }
+        None => SystemTime::now().checked_add(Duration::from_secs(default_secs)),
+    }
+    .ok_or_else(|| Error::BadTokenHeader("expiration out of range".to_string()))?;
+    Ok((id.to_string(), FetchedToken { token: token.to_string(), expiration }))
+}
+
+fn header_str(value: &HeaderValue) -> Result<&str, Error> {
+    value.to_str().map_err(|_| Error::BadTokenHeader("header is not visible ASCII".to_string()))
+}
+
+#[cfg(test)]
+mod token_header_tests {
+    use super::*;
+
+    #[test]
+    fn parses_relative_duration_as_seconds_from_now() {
+        let before = SystemTime::now() + Duration::from_secs(60);
+        let encoded = base64::encode("id:token:60");
+        let (_, token) = parse_token_header(&encoded, 300).expect("relative token header");
+        let after = SystemTime::now() + Duration::from_secs(60);
+
+        assert!(token.expiration >= before);
+        assert!(token.expiration <= after);
+    }
+
+    #[test]
+    fn parses_epoch_milliseconds_as_absolute_time() {
+        const EPOCH_MS: u64 = 1_700_000_000_000;
+        let encoded = base64::encode(format!("id:token:60:{EPOCH_MS}"));
+        let (_, token) = parse_token_header(&encoded, 300).expect("epoch-ms token header");
+
+        assert_eq!(
+            token.expiration,
+            SystemTime::UNIX_EPOCH + Duration::from_millis(EPOCH_MS)
+        );
     }
 }
 
